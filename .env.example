# ✅ Supabase Configuration (Required for public client)
# These are intentionally public - they identify your Supabase project but don't grant write access
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ✅ Supabase Service Role Key (Server-side only - DO NOT expose to client)
# This key has full database access and must NEVER be committed to git
# Get this from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ✅ SMS Provider Configuration
# These should be configured in the Supabase database (app_settings table)
# Do not commit actual credentials here

# ✅ Other Environment Variables
# Add other production variables below
